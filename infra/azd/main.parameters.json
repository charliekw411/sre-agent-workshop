{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "envName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=australiaeast}"
    },
    "deployerPrincipalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "deployerPrincipalType": {
      "value": "${AZURE_PRINCIPAL_TYPE}"
    },
    "vmSshPublicKey": {
      "value": "${VM_SSH_PUBLIC_KEY}"
    },
    "vmSize": {
      "value": "${VM_SIZE=Standard_D2as_v5}"
    },
    "alertEmail": {
      "value": "${ALERT_EMAIL=}"
    }
  }
}
